typedef unsigned int uint32_t;

#define PAGE_SIZE 4096
#define PAGE_TABLE_COUNT 4

static uint32_t page_directory[1024] __attribute__((aligned(4096)));
static uint32_t page_tables[PAGE_TABLE_COUNT][1024] __attribute__((aligned(4096)));

void paging_init() {
    uint32_t i;
    uint32_t j;

    for (i = 0; i < 1024; i++)
        page_directory[i] = 0;

    for (i = 0; i < PAGE_TABLE_COUNT; i++) {
        for (j = 0; j < 1024; j++) {
            page_tables[i][j] =
                (i * 1024 * PAGE_SIZE) +
                (j * PAGE_SIZE) |
                0x3;
        }

        page_directory[i] =
            ((uint32_t)page_tables[i]) | 0x3;
    }

    __asm__ volatile (
        "mov %0, %%cr3"
        :
        : "r"(page_directory)
    );

    uint32_t cr0;

    __asm__ volatile (
        "mov %%cr0, %0"
        : "=r"(cr0)
    );

    cr0 |= 0x80000000;

    __asm__ volatile (
        "mov %0, %%cr0"
        :
        : "r"(cr0)
    );
}

int paging_enabled() {
    uint32_t cr0;

    __asm__ volatile (
        "mov %%cr0, %0"
        : "=r"(cr0)
    );

    return (cr0 & 0x80000000) != 0;
}