typedef unsigned int uint32_t;

#define PAGE_SIZE 4096
#define PAGE_TABLE_COUNT 4

static uint32_t page_directory[1024] __attribute__((aligned(4096)));
static uint32_t page_tables[PAGE_TABLE_COUNT][1024] __attribute__((aligned(4096)));

static void invalidate_page(uint32_t virtual_address) {
    __asm__ volatile (
        "invlpg (%0)"
        :
        : "r"(virtual_address)
        : "memory"
    );
}

void paging_init() {
    uint32_t i;
    uint32_t j;

    for (i = 0; i < 1024; i++)
        page_directory[i] = 0;

    for (i = 0; i < PAGE_TABLE_COUNT; i++) {
        for (j = 0; j < 1024; j++) {
            page_tables[i][j] =
                (i * 1024 * PAGE_SIZE) +
                (j * PAGE_SIZE) |
                0x3;
        }

        page_directory[i] =
            ((uint32_t)page_tables[i]) | 0x3;
    }

    __asm__ volatile (
        "mov %0, %%cr3"
        :
        : "r"(page_directory)
    );

    uint32_t cr0;

    __asm__ volatile (
        "mov %%cr0, %0"
        : "=r"(cr0)
    );

    cr0 |= 0x80000000;

    __asm__ volatile (
        "mov %0, %%cr0"
        :
        : "r"(cr0)
    );
}

int paging_enabled() {
    uint32_t cr0;

    __asm__ volatile (
        "mov %%cr0, %0"
        : "=r"(cr0)
    );

    return (cr0 & 0x80000000) != 0;
}

int map_page(uint32_t virtual_address, uint32_t physical_address) {
    uint32_t directory_index;
    uint32_t table_index;

    if (virtual_address % PAGE_SIZE != 0)
        return 0;

    if (physical_address % PAGE_SIZE != 0)
        return 0;

    directory_index = virtual_address >> 22;
    table_index = (virtual_address >> 12) & 0x3FF;

    if (directory_index >= PAGE_TABLE_COUNT)
        return 0;

    if (!(page_directory[directory_index] & 0x1))
        return 0;

    page_tables[directory_index][table_index] =
        physical_address | 0x3;

    invalidate_page(virtual_address);

    return 1;
}

int unmap_page(uint32_t virtual_address) {
    uint32_t directory_index;
    uint32_t table_index;

    if (virtual_address % PAGE_SIZE != 0)
        return 0;

    directory_index = virtual_address >> 22;
    table_index = (virtual_address >> 12) & 0x3FF;

    if (directory_index >= PAGE_TABLE_COUNT)
        return 0;

    if (!(page_directory[directory_index] & 0x1))
        return 0;

    page_tables[directory_index][table_index] = 0;

    invalidate_page(virtual_address);

    return 1;
}

int is_page_mapped(uint32_t virtual_address) {
    uint32_t directory_index;
    uint32_t table_index;

    if (virtual_address % PAGE_SIZE != 0)
        return 0;

    directory_index = virtual_address >> 22;
    table_index = (virtual_address >> 12) & 0x3FF;

    if (directory_index >= PAGE_TABLE_COUNT)
        return 0;

    if (!(page_directory[directory_index] & 0x1))
        return 0;

    return (page_tables[directory_index][table_index] & 0x1) != 0;
}